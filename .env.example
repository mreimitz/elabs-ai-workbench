NODE_ENV=development
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
DATABASE_PATH=./data/app.sqlite
# Where Testing-feature attachment blobs (multimodal test inputs) are stored.
# Optional — defaults to DATA_DIR/attachments. In Docker DATA_DIR=/data, so attachments
# persist on the same /data volume as the DB + secret key with no extra config.
ATTACHMENTS_DIR=./data/attachments
DEFAULT_TOKEN_PROFILE=generic_o200k

# Optional. When omitted, the API generates DATA_DIR/mcp-secret.key for local secret encryption.
MCP_SECRET_KEY=
MCP_SECRET_KEY_PATH=./data/mcp-secret.key

# OAuth redirect for streamable HTTP MCP servers that support OAuth.
OAUTH_REDIRECT_URL=http://127.0.0.1:8080/api/oauth/callback

# Where the API serves the built web SPA from (@fastify/static). Optional — defaults to
# apps/web/dist relative to the repo root. Set this when the built web dist lives elsewhere
# (e.g. the Docker runtime image copies it to /app/web/dist). Read in apps/api/src/config/env.ts.
WEB_DIST_PATH=

# Force "Docker mode" behavior. Optional — defaults to true whenever DATA_DIR resolves to /data,
# so you normally never set this. Read in apps/api/src/config/env.ts.
DOCKER_MODE=

# --- Skills registry (Phase 1) ---
# Ingest size caps / zip-bomb guard, enforced on BOTH ingestion paths (uploaded .zip AND GitHub
# import/pull). Optional — when omitted the shared-constant defaults below apply. Skill content is
# NEVER executed; these caps only bound what the registry will store. Values are in bytes / file
# count; a breach is rejected with a clear 4xx and no partial rows.
SKILL_MAX_FILE_BYTES=5242880    # 5 MB per file (default)
SKILL_MAX_TOTAL_BYTES=52428800  # 50 MB per skill version, whole tree (default)
SKILL_MAX_FILES=2000            # max files per skill version (default)

# --- Skill IDE quality engine (WP 4.1) ---
# Token-budget ceilings above which the quality engine raises an l1-budget / l2-budget warning.
# Optional — when omitted the shared-constant defaults apply. L1 = always-resident metadata
# (name + description); L2 = the SKILL.md body loaded in full on trigger.
SKILL_QUALITY_L1_TOKEN_CEILING=500   # L1 metadata token ceiling (default)
SKILL_QUALITY_L2_TOKEN_CEILING=5000  # L2 body token ceiling (default)

# Scan retention (issue #19): "keep last N scans per server". Optional. 0 (default) = disabled —
# keep all scan history. When > 0, a successful scan prunes that server's older scans (cascading
# their tool/resource/prompt/event rows), and POST /api/maintenance/prune-scans prunes on demand.
SCAN_RETENTION_PER_SERVER=0

# --- Testing feature (run engine) ---
# LLM provider API keys are NOT read from the environment. They are entered in the UI and
# stored AES-256-GCM-encrypted in the SQLite DB (apps/api/src/providers). There is currently
# no *_API_KEY env fallback in runtime code — do not expect one here. (ANTHROPIC_API_KEY is
# only consulted by the optional, self-skipping live smoke tests, never by the running app.)
#
# Per-model pricing (for the run cost KPI + spend-cap guardrail) is maintained MANUALLY in
# code at apps/api/src/providers/pricing.ts (MODEL_PRICING) — there is no env var or live feed.

# --- Assistant (roadmap/assistant/) — embedded Claude agent chat ---
# The Claude Pro/Max OAuth token (or Anthropic API key fallback) is entered via Settings and
# stored encrypted in the DB — same as MCP secrets and provider credentials, NOT read from env.
# See apps/api/src/assistant/spawn-env.ts: the SDK child process env is built fresh per session
# from exactly one auth source, HOME/CLAUDE_CONFIG_DIR under ASSISTANT_DATA_DIR, and PATH —
# nothing else (never MCP_SECRET_KEY, DATABASE_PATH, or any other app secret/config).
#
# Optional. When omitted, defaults to DATA_DIR/assistant (so it persists on the same /data
# volume as the DB in Docker). Holds the SDK's CLAUDE_CONFIG_DIR + HOME and materialized
# skill-edit workspaces — never the operator's real ~/.claude state.
ASSISTANT_DATA_DIR=./data/assistant
# Turn cap for the WHOLE warm session, passed to the SDK (`query({ options: { maxTurns } })`).
# NOT reset per message: one query() serves every message a warm session handles until it's
# parked/aborted, so this budget is shared across all of them — a fresh one only starts on the
# next park/resume.
ASSISTANT_MAX_TURNS=50
# Idle timeout (ms) before a warm assistant session's child process is parked.
ASSISTANT_IDLE_TIMEOUT_MS=600000
# Max concurrent live SDK child processes across all threads. Each active session is roughly up
# to ~1 GiB resident — see README.md's "Concurrency & memory" note under Assistant.
ASSISTANT_MAX_ACTIVE_SESSIONS=2
# How long (ms) a gated write's approval card waits for an owner decision before it auto-denies
# (fail-closed). Optional — defaults to ASSISTANT_DEFAULT_PERMISSION_TIMEOUT_MS (5 minutes).
ASSISTANT_PERMISSION_TIMEOUT_MS=300000
# Thread/event + skill-workspace + SDK session-transcript retention in days. Optional. 0
# (default) = disabled — keep everything, same opt-in-retention convention as
# SCAN_RETENTION_PER_SERVER. POST /api/maintenance/prune-assistant prunes on demand (also
# reachable from Settings -> Storage & maintenance); its orphaned-directory sweep is
# unconditional and still runs even when this is 0.
ASSISTANT_SESSION_RETENTION_DAYS=0
# Comma-separated model-picker roster for GET /api/assistant/models. Optional — defaults to
# ASSISTANT_DEFAULT_MODEL_ROSTER (packages/shared/src/constants.ts): the SDK's own live roster
# needs an already-running session, not available at a plain settings-time GET.
ASSISTANT_MODEL_ROSTER=
# R2 (D-AS25) — grace (ms) between a turn completing and the thread's live SDK session being
# released (parked: child killed, cap slot freed, sdkSessionId kept for resume). Optional. 0
# (default) = release the moment the turn ends, so the "too many sessions" cap 409 disappears
# (normally <=1 active session). A few seconds keeps the child warm for instant follow-ups at the
# cost of holding a cap slot that long.
ASSISTANT_RELEASE_GRACE_MS=0
# R2 (D-AS26) — best-effort LLM-refined thread title after the first reply. Optional. Default ON
# (true): a bounded one-shot on ASSISTANT_TITLE_MODEL summarizes the first message + reply into a
# crisp title. It is NEVER counted toward ASSISTANT_MAX_ACTIVE_SESSIONS, is hard-timeout bounded,
# and SILENTLY falls back to the deterministic (message-derived) title on any error/timeout — that
# deterministic title is always the guaranteed floor. Because it is a real (small) SDK call it
# spends a little on the thread's auth source; set to false to run the deterministic title only.
ASSISTANT_AUTO_TITLE=true
# R2 (D-AS26) — the cheap model the title one-shot runs on. Optional — defaults to
# ASSISTANT_DEFAULT_TITLE_MODEL (the cheapest tier of ASSISTANT_DEFAULT_MODEL_ROSTER).
ASSISTANT_TITLE_MODEL=
# R2 (D-AS26) — hard timeout (ms) for the title one-shot; on timeout the deterministic title is
# kept. Optional — defaults to ASSISTANT_DEFAULT_TITLE_TIMEOUT_MS (15000).
ASSISTANT_TITLE_TIMEOUT_MS=15000
# The Settings/dock near-expiry warning threshold (~335 days) is a fixed constant
# (ASSISTANT_TOKEN_EXPIRY_WARNING_DAYS in packages/shared/src/constants.ts), not an env var —
# there is nothing to configure here for it.
# Refinement R1 (WP R1.2) — the bundled, read-only skill-authoring reference directory (a
# distilled skill-creator fallback + best-practices checklist; see
# apps/api/resources/skill-authoring/skill-creator/SKILL.md) added to a skill-scoped session's
# additionalDirectories. Optional — defaults to <this package>/resources/skill-authoring,
# resolved relative to the running module so it works in both dev (tsx) and the built image.
ASSISTANT_SKILL_AUTHORING_DIR=

# --- Auto-Rating (roadmap/auto-rating/) — post-run validation graders ---
# Max concurrent Claude-CLI judge one-shots (AR14). The CLI judge chain spawns a Claude Agent SDK
# child per grade (~1 GiB resident), so it acquires a semaphore before spawning. Optional — a
# positive integer, defaults to 1 (serial) to bound memory. Raise only where you have RAM headroom.
AUTO_RATING_MAX_CONCURRENCY=1
# Ops kill-switch (AR5). The base-rating graders are product-mandatory — they run on EVERY terminal run
# (completed/stopped/error/aborted) — but ops-stoppable: set to false to skip the MANDATORY graders
# entirely. Expectation grading is unaffected. Optional — default true; only the literal "false"
# disables. No per-test opt-out.
AUTO_RATING_ENABLED=true

# --- Fleet issue LLM assist (roadmap/observability/, WP5.2, D-OB20) — OPT-IN ---
# An opt-in LLM pass OVER the deterministic fleet clusters: it merges near-duplicate issues, writes
# human titles/summaries, and suggests a priority (never auto-applied) — through the SAME CLI-first
# judge chain the graders use, but on its OWN concurrency + setting (deliberately NOT
# AUTO_RATING_MAX_CONCURRENCY) and its OWN cost ledger. Max concurrent assist PASSES; positive int,
# default 1.
ISSUE_ASSIST_MAX_CONCURRENCY=1
# Run the assist pass automatically after each fleet-issue sweep. Default FALSE (assist is manual — the
# issues UI's "Refine with AI" endpoint drives it). Only true/1/yes/on enables it; even when enabled,
# an assist error never breaks the sweep.
ISSUE_ASSIST_AFTER_SWEEP=false

# --- Assistant Hub (roadmap/assistant-hub/, WP0.5) — tool-registry defaults ---
# Default per-session tool-loading preference (eager/deferred/auto). WP1.1 (hub-fixes, D-HF1) flips the
# code default to "auto": load eager when the granted catalog fits the token threshold, else deferred-
# WITH-PROMOTION (a `tool_search` hit becomes callable in later steps of the same turn). Optional — falls
# back to "auto" on an unrecognized value.
# NOTE: docker-compose.yml still pins this to "eager" as WP 0.1's same-day mitigation. Now that WP 1.1
# has landed (auto + deferred-promotion), that override is OPTIONAL — remove it to run on the "auto"
# default (safer for unscoped multi-server sessions, which "auto" defers instead of blowing the budget).
# Eager loads full definitions for every granted server (~10k-50k+ tokens each), so scope sessions and
# watch the Assistant Hub Context gauge (right meta rail).
HUB_TOOL_LOADING_DEFAULT=auto
# The `auto` loading-mode heuristic: eager iff ALL granted MCP tool definitions fit within this
# fraction of the model's context window. Optional — a (0, 1] fraction, defaults to 0.10.
HUB_TOOL_SEARCH_AUTO_FRACTION=0.10

# --- Assistant Hub (hub-fixes, WP1.1 / D-HF1) — deferred-promotion caps ---
# Absolute upper bound (tokens) on the `auto`-resolves-eager threshold: `auto` loads eager iff the
# granted catalog fits within min(contextWindow * HUB_TOOL_SEARCH_AUTO_FRACTION, this), so a huge
# context window can never let a large catalog load eager and blow the budget. Optional, default 40000.
HUB_TOOL_EAGER_MAX_TOKENS=40000
# Per-`tool_search` promotion token cap: one search can make at most this many tokens of deferred-tool
# definitions callable; over-cap matches are returned as data with a "narrow your query" note. Optional,
# default 20000.
HUB_TOOL_PROMOTE_MAX_TOKENS=20000
# Tool-result size warn/cap thresholds (tokens). At/under WARN passes through untouched; above WARN
# (but at/under MAX) passes through with a size warning; above MAX spills to the session workspace as
# a file + a reference card. Optional positive integers, default 10000 / 25000.
HUB_MCP_OUTPUT_WARN_TOKENS=10000
HUB_MCP_OUTPUT_MAX_TOKENS=25000
# Workspace-write size cap (Wave-3 adversarial-review F2): the byte ceiling `hub/workspace.ts`'s
# writeWorkspaceTextFile enforces on any write into a session's workspace (files.write/files.edit and
# the output-cap spill path above). Optional positive integer, default 5000000 (5 MB).
HUB_WS_MAX_FILE_BYTES=5000000

# --- Assistant Hub (roadmap/assistant-hub/, WP1.1) — session-engine knobs ---
# Max concurrent LIVE hub turns (the active-session registry cap; a dispatch beyond it 409s). Optional
# positive integer, default 4. Stall/wait budgets are NOT set here — they inherit the Unified-Sessions
# SessionClock defaults (10-min stall / 10-min wait).
HUB_MAX_ACTIVE_SESSIONS=4
# Release-on-reply grace (ms) between a turn settling and its live slot being freed. Optional
# non-negative integer, default 0 = release the instant the turn ends (the cap never wedges).
HUB_SESSION_IDLE_RELEASE_MS=0
# Best-effort deterministic-then-LLM-refine session title after the first turn. ON by default; the
# refine is a bounded, non-blocking one-shot that falls back to the deterministic title on any error.
# Set to false to keep the deterministic title only. Optional boolean, default true.
HUB_AUTO_TITLE=true

# --- Assistant Hub (roadmap/assistant-hub/, WP1.7) — mission knobs (D-AH6/8/9) ---
# HARD CAPS + autonomy thresholds enforced server-side regardless of a plan's own budgets or the
# autonomy dial: a plan's maxAgents/maxParallel/maxCostUsd are clamped DOWN to these, never up.
# Widest fan-out a mission may spawn (excess planned agents are dropped). Optional int, default 6.
HUB_MISSION_MAX_AGENTS=6
# Max agents running CONCURRENTLY; the rest queue (subscription memory wall — prefer API-keyed models
# for wide fan-outs; the board shows the queue honestly). Optional int, default 3.
HUB_MISSION_MAX_PARALLEL=3
# Mission-wide total cost cap applied when the plan names no maxCostUsd; a tripped budget stops
# cleanly and synthesizes partially, honestly marked. Optional positive float (USD), default 2.00.
HUB_MISSION_DEFAULT_BUDGET_USD=2.00
# The ABSOLUTE ceiling on a mission's maxCostUsd (D-AH9: total cost is a HARD cap, not a dial) — a
# plan/crew/edit naming a maxCostUsd above this is clamped down to it regardless (unlike the default
# above, which only supplies a value when the plan names none). Optional positive float (USD),
# default 10.00 — generous but bounded; keep it >= HUB_MISSION_DEFAULT_BUDGET_USD.
HUB_MISSION_MAX_BUDGET_USD=10.00
# crew-nesting (D-CN3/D-CN10) — max nesting depth a mission tree may reach (root = depth 1; a nested
# sub-mission adds a level). Optional int, default 2 (root + one nested level). Set to 1 to reproduce
# today's exact pre-nesting behavior (a crewId member is rejected at author time as over-depth).
HUB_MISSION_MAX_DEPTH=2
# crew-nesting (D-CN3/D-CN10) — transitive whole-tree leaf-agent ceiling, backstopping the per-mission
# HUB_MISSION_MAX_AGENTS above. Optional int, default 24.
HUB_MISSION_MAX_TOTAL_AGENTS=24
# The `threshold` autonomy dial's ceilings: a threshold mission auto-launches only when its agent
# count AND estimated cost are at/under BOTH; otherwise it waits for approval (always_ask always
# waits; auto always launches — hard caps still apply). Optional int / positive float, defaults 3 / 1.00.
HUB_AUTONOMY_ASK_ABOVE_AGENTS=3
HUB_AUTONOMY_ASK_ABOVE_USD=1.00
# The autonomy dial applied to a session that sets none (WP2.3, D-AH6). Governs live HITL tool-approval
# gating: `always_ask` (default) gates every side-effecting MCP tool call on an approval card; `auto`
# auto-runs read-only tools on owner-trusted servers; `threshold` behaves like `auto` at the tool floor
# (its ceilings above govern mission launch). Hard budget caps are enforced regardless of the dial.
HUB_DEFAULT_AUTONOMY=always_ask
# hub-fixes WP2.1 (RC2, D-HF7): the mission agent-runner rollback seam. `session` (default) runs each
# planned mission agent as a REAL child hub session through the turn engine — granted MCP tools callable,
# real usage/cost, live transcript — then extracts a structured report; `structured` keeps the old
# one-shot generateObject runner wired for one release (byte-compatible fallback). Anything else ⇒ session.
HUB_AGENT_RUNNER=session
# hub-fixes WP3.2 (RC4, D-HF4): the mission-synthesis path. `turn` (default) runs the synthesis as a REAL
# turn of the parent session through the turn engine WITH the GenUI `present` tools granted (MCP tools are
# NOT — synthesis reasons over the agent reports, it never re-queries), so the final answer can render
# Table/StatGroup/Chart widgets plus prose. `text` keeps the pre-fix tool-less generateText synthesizer
# (the byte-compatible fallback the `turn` path also uses on any turn failure). Anything else ⇒ turn.
HUB_SYNTHESIS_MODE=turn
# hub-fixes WP2.5 (D-HF6): the auto-deny budget (seconds) for an `always_ask` mission's board approval
# cards. A gated child tool call queued to the board and left unanswered this long is auto-denied so the
# mission always TERMINATES (a silent stall is a defect; the agent then proceeds without that call).
# Optional positive int, default 300 (5 min). Irrelevant to auto/threshold missions (no board card).
HUB_MISSION_APPROVAL_TIMEOUT_S=300
# Skill attachment (WP2.4, R-SK1/R-SK2): the L1 catalog's token ceiling as a fraction of the model's
# context window, and its per-entry description truncation. Optional fraction / positive int, defaults
# 0.01 (1%) / 1536.
HUB_SKILL_LISTING_BUDGET_FRACTION=0.01
HUB_SKILL_ENTRY_MAX_CHARS=1536
# The `skills.load` on-demand budget: what a single skill / the whole session may load into context,
# compaction-protected. Optional positive int, defaults 5000 / 25000.
HUB_SKILL_COMPACTION_TOKENS_PER_SKILL=5000
HUB_SKILL_COMPACTION_TOKENS_TOTAL=25000
# Declarative GenUI (WP2.6, R-GUI4): how many times a `present`/`prompt_user` UI spec that fails the
# component-catalog allowlist is fed typed errors back to the model to re-emit before the tool gives up
# and shows an honest recovery card. Optional non-negative int, default 2.
HUB_GENUI_MAX_REPAIR_ATTEMPTS=2
# Context-window compaction (WP3.3, R-SES8): compact the model history when it reaches this fraction of
# the model's context window (clear cold tool outputs first, then summarize), keeping this many recent
# user turns hot (verbatim). Optional fraction / positive int, defaults 0.75 / 4.
HUB_COMPACTION_THRESHOLD_FRACTION=0.75
HUB_COMPACTION_KEEP_RECENT_TURNS=4
# Projects + pinned context (WP3.1, D-AH11c): the character cap on a project's assembled
# instructions + pinned-files body before it's injected into LAYER 6b of the system prompt (the
# layer's own token budget covers only the static framing prose — this caps the variable, owner-
# authored content). Optional positive int, default 8000 (~2000 tokens at a rough 4-chars/token ratio).
HUB_PROJECT_CONTEXT_MAX_CHARS=8000

# --- Assistant Hub (roadmap/assistant-hub/, WP4.3) — hardening: retention + on-disk layout ---
# Root-session/workspace/file retention window (days) for POST /api/maintenance/prune-hub. 0 (default)
# = disabled (keep everything) — the SAME opt-in-retention convention as SCAN_RETENTION_PER_SERVER /
# ASSISTANT_SESSION_RETENTION_DAYS. When > 0, a settled root session (chat/research/mission) whose
# `updated_at` predates the window is pruned — but a root that started a mission is skipped unless the
# mission ITSELF has also reached a terminal status (a mission runs independently of its parent
# session's own per-turn status). The orphan workspace-dir + dangling-file sweeps run unconditionally
# regardless of this setting.
HUB_SESSION_RETENTION_DAYS=0
# --- Assistant Hub (hub-fixes WP5.1, RC5, D-HF2) — web tools (internet access) ---
# Master kill switch for the two "web" built-ins: the session model's own provider-native `web.search`
# (Anthropic/OpenAI/Google — absent on openai_compatible/ollama) and the app-level, SSRF-guarded,
# GET-only `web.fetch`. Default on. Set HUB_WEB_TOOLS=off to remove BOTH everywhere (top-level sessions
# AND mission agents); the tools prompt then explains the absence when a scope requested one. When on,
# both are grantable via a session/role tool scope, and a NEW top-level session on a search-capable
# model gets them by default; mission agents only ever get them when the planner grants them explicitly.
HUB_WEB_TOOLS=on
# On-disk layout under DATA_DIR (no separate env var — always DATA_DIR-relative, unlike
# ASSISTANT_DATA_DIR above, which is independently overridable): a hub session's materialized
# workspace (files.{list,read,write,edit}, output-cap spill, workspace snapshots) lives at
# DATA_DIR/hub/ws/<sessionId>/ — in Docker, /data/hub/ws/<sessionId>/, on the SAME persistent /data
# volume as the DB (see docker-compose.yml's mcp-token-footprint-data volume). Uploaded file BYTES
# (hub_files) live in SQLite, not on disk. Nothing in this tree is ever executed — read/write only
# (.claude/rules/mcp-and-security.md).
