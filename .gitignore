node_modules
dist
**/dist
# Only the runtime SQLite dir at the project root. `/data` is anchored, so it matches ONLY that dir:
# `data-pack/` (the versioned reference data pack) and the bundled apps/api/src/compatibility/data
# snapshot are NOT matched and stay versioned.
/data
.env
.env.*
!.env.example
coverage
*.log
.DS_Store

# Playwright e2e (#29) — generated report/output/cache dirs, never committed.
test-results
playwright-report
.playwright

# The `mcpfp` CLI's local config (roadmap/ci/ WP 1.2). It MAY carry a service token, so it must
# never be committed — the CLI also warns on stderr whenever a token is resolved from it.
mcpfp.config.json

# Filesystem / tooling artifacts (FUSE mounts, stray pnpm temp probes)
.fuse_hidden*
_tmp_*
_unlinktest
.wp-evidence/
data-wt/

# Vitest transpiled-config temp files
vitest.config.ts.timestamp-*.mjs
apps/*/vitest.config.ts.timestamp-*.mjs

# Staged real-run payloads used as extraction fixtures (scratch — never committed)
.qa-fixtures/

# Transient git worktrees created by the /next-wp runner (one per work package).
.worktrees/
# Same, for the harness-managed worktree isolation used by sub-agents.
.claude/worktrees/

# Build artifacts produced by gates that MEASURE the repo rather than change it
# (`pnpm mcp:self-scan` → .artifacts/mcp-self-scan/footprint.{json,md}). Regenerated on demand and
# uploaded by CI; never committed, so a measurement can never go stale in git.
.artifacts/

# OKF planning bundle tooling
planning/**/__pycache__/
planning/tools/.venv/

# packages/shared build-once guard (scripts/build-shared-once.mjs)
packages/shared/.build-stamp
packages/shared/.build-lock/
