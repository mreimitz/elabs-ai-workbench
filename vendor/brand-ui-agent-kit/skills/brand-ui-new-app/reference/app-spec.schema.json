{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "brand-ui/app-spec",
  "title": "brand-ui app-spec",
  "description": "The machine-readable contract the new-app interview produces and `brand-ui scaffold` consumes. Authored as a fenced ```json block inside app-spec.md (single source: prose for humans, this block for the engine). Mirrors the input shape of `planScaffold` in the @brand/cli scaffold engine; #123 makes scaffold extract this block from app-spec.md.",
  "type": "object",
  "required": ["archetype", "theme", "title"],
  "additionalProperties": true,
  "properties": {
    "archetype": {
      "description": "App shape → the generated playbooks/templates/<archetype>.tsx + playbooks/<archetype>.md.",
      "type": "string",
      "enum": ["dashboard", "data-app", "ai-assistant", "flow-workspace", "settings", "marketing"]
    },
    "theme": {
      "description": "Shipped theme slug (CSS slug, never display name).",
      "type": "string",
      "enum": ["qlik-bright", "qlik-dark", "blueprint"],
      "default": "qlik-bright"
    },
    "title": {
      "description": "App title (free text; defaults to the archetype name).",
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "description": "Why the app exists (stage 1).",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "purpose": { "type": "string" },
        "audience": { "type": "string" },
        "scale": { "type": "string", "enum": ["demo", "internal", "production"] }
      }
    },
    "density": {
      "description": "Visual density (text is never resized; spacing only).",
      "type": "string",
      "enum": ["default", "compact"],
      "default": "default"
    },
    "surfaces": {
      "description": "Screens/sections; one archetype per surface, shared app shell.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "navLabel"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "navLabel": { "type": "string", "minLength": 1 },
          "archetype": {
            "type": "string",
            "enum": [
              "dashboard",
              "data-app",
              "ai-assistant",
              "flow-workspace",
              "settings",
              "marketing"
            ]
          }
        }
      }
    },
    "entities": {
      "description": "Domain objects → generated interface + ColumnDef<Entity>[] at scaffold time.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "fields"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "additionalProperties": true,
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": {
                  "type": "string",
                  "enum": ["text", "number", "date", "status", "boolean"]
                },
                "rendersAs": { "type": "string" },
                "filterable": { "type": ["boolean", "string"] }
              }
            }
          }
        }
      }
    }
  }
}
