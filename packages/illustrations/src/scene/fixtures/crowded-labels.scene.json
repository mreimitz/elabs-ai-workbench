    },
    { "id": "k-read", "from": "north.read", "to": "east.top", "kind": "read" },
    { "id": "k-write", "from": "west.top", "to": "north.write", "kind": "write" },
    { "id": "k-publish", "from": "south.read", "to": "east.bottom", "kind": "publish" },
    { "id": "k-loop", "from": "west.bottom", "to": "south.write", "kind": "loop" },
    { "id": "k-signal", "from": "north.bottom", "to": "south.top", "kind": "signal" }
  ]
