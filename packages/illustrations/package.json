{
  "name": "@mcp-token-footprint/illustrations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./src/tokens.ts",
      "development": "./src/tokens.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @mcp-token-footprint/shared build && tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "preview": "tsx scripts/build-preview.ts",
    "preview:shots": "tsx scripts/build-preview.ts && tsx scripts/screenshot-preview.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@mcp-token-footprint/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
