{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qlabs/mcp-token-footprint/token-context-comparison/model-entry.schema.json",
  "title": "Provider model-comparison entry",
  "description": "One provider's metadata plus its latest models, profiled on the seven comparison axes. See 01-information-structure.md.",
  "type": "object",
  "required": ["schema_version", "as_of", "provider", "models"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "as_of": { "type": "string", "format": "date" },
    "provider": { "$ref": "#/$defs/provider" },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "tier": { "type": "integer", "enum": [1, 2, 3, 4] },
    "provenanced": {
      "type": "object",
      "description": "A factual value with its provenance. value+confidence required; null value means unknown (explain in notes).",
      "required": ["value", "confidence"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["string", "number", "integer", "boolean", "null"] },
        "unit": { "type": "string" },
        "source_url": { "type": ["string", "null"] },
        "source_tier": { "$ref": "#/$defs/tier" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "as_of": { "type": "string", "format": "date" },
        "derived": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "provider": {
      "type": "object",
      "required": ["id", "name", "group", "homepage", "api_docs_url"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "group": { "type": "string", "enum": ["saas", "open_weight"] },
        "homepage": { "type": "string" },
        "api_docs_url": { "type": "string" },
        "tokenizer_docs_url": { "type": ["string", "null"] },
        "native_mcp_support": { "$ref": "#/$defs/provenanced" },
        "skills_concept": { "$ref": "#/$defs/provenanced" }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "status",
        "context",
        "tokenization",
        "tools_mcp",
        "skills_context",
        "cost",
        "sources"
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "display_name": { "type": "string" },
        "family": { "type": "string" },
        "release_date": { "$ref": "#/$defs/provenanced" },
        "status": { "type": "string", "enum": ["ga", "preview", "deprecated"] },
        "knowledge_cutoff": { "$ref": "#/$defs/provenanced" },
        "modalities": { "type": "array", "items": { "type": "string" } },
        "context": {
          "type": "object",
          "additionalProperties": true,
          "required": ["context_window_tokens", "max_output_tokens_max"],
          "properties": {
            "context_window_tokens": { "$ref": "#/$defs/provenanced" },
            "input_output_shared": { "$ref": "#/$defs/provenanced" },
            "max_input_tokens": { "$ref": "#/$defs/provenanced" },
            "max_output_tokens_default": { "$ref": "#/$defs/provenanced" },
            "max_output_tokens_max": { "$ref": "#/$defs/provenanced" },
            "extended_context": { "$ref": "#/$defs/provenanced" },
            "reasoning_tokens_count_as_output": { "$ref": "#/$defs/provenanced" }
          }
        },
        "tokenization": {
          "type": "object",
          "additionalProperties": true,
          "required": ["tokenizer_family", "tokenizer_public"],
          "properties": {
            "tokenizer_family": { "$ref": "#/$defs/provenanced" },
            "tokenizer_public": { "$ref": "#/$defs/provenanced" },
            "tokenizer_access": { "$ref": "#/$defs/provenanced" },
            "count_tokens_method": { "$ref": "#/$defs/provenanced" },
            "image_token_rule": { "$ref": "#/$defs/provenanced" },
            "audio_token_rule": { "$ref": "#/$defs/provenanced" },
            "chars_per_token_estimate": { "$ref": "#/$defs/provenanced" }
          }
        },
        "tools_mcp": {
          "type": "object",
          "additionalProperties": true,
          "required": ["function_calling", "max_tools_hard", "tool_defs_count_as_input"],
          "properties": {
            "function_calling": { "$ref": "#/$defs/provenanced" },
            "native_mcp": { "$ref": "#/$defs/provenanced" },
            "parallel_tool_calls": { "$ref": "#/$defs/provenanced" },
            "max_tools_hard": { "$ref": "#/$defs/provenanced" },
            "max_tools_practical": { "$ref": "#/$defs/provenanced" },
            "tool_definition_shape": { "$ref": "#/$defs/provenanced" },
            "tool_defs_count_as_input": { "$ref": "#/$defs/provenanced" },
            "tool_search_deferral": { "$ref": "#/$defs/provenanced" },
            "max_tool_name_len": { "$ref": "#/$defs/provenanced" },
            "max_tool_description_len": { "$ref": "#/$defs/provenanced" },
            "max_request_size": { "$ref": "#/$defs/provenanced" },
            "max_tool_result_size": { "$ref": "#/$defs/provenanced" },
            "max_parallel_tool_calls_count": { "$ref": "#/$defs/provenanced" },
            "tool_use_per_turn_limit": { "$ref": "#/$defs/provenanced" },
            "max_connected_servers": { "$ref": "#/$defs/provenanced" },
            "max_total_tools": { "$ref": "#/$defs/provenanced" },
            "tool_schema_limits_notes": { "type": ["string", "null"] },
            "other_limits_notes": { "type": ["string", "null"] }
          }
        },
        "skills_context": {
          "type": "object",
          "additionalProperties": true,
          "required": ["skills_supported"],
          "properties": {
            "skills_supported": { "$ref": "#/$defs/provenanced" },
            "skills_loading_model": { "$ref": "#/$defs/provenanced" },
            "skills_context_cost_notes": { "type": ["string", "null"] },
            "system_prompt_overhead_notes": { "type": ["string", "null"] },
            "prompt_caching": { "$ref": "#/$defs/provenanced" },
            "memory_feature": { "$ref": "#/$defs/provenanced" }
          }
        },
        "cost": {
          "type": "object",
          "additionalProperties": true,
          "required": ["billing_unit"],
          "properties": {
            "input_per_mtok_usd": { "$ref": "#/$defs/provenanced" },
            "output_per_mtok_usd": { "$ref": "#/$defs/provenanced" },
            "cached_input_per_mtok_usd": { "$ref": "#/$defs/provenanced" },
            "batch_discount": { "$ref": "#/$defs/provenanced" },
            "billing_unit": { "$ref": "#/$defs/provenanced" },
            "multimodal_billing_notes": { "type": ["string", "null"] },
            "reasoning_billed_as_output": { "$ref": "#/$defs/provenanced" }
          }
        },
        "self_host": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "properties": {
            "weights_url": { "$ref": "#/$defs/provenanced" },
            "license": { "$ref": "#/$defs/provenanced" },
            "param_variants": { "$ref": "#/$defs/provenanced" },
            "native_context_config": { "$ref": "#/$defs/provenanced" },
            "max_context_documented": { "$ref": "#/$defs/provenanced" },
            "serving_frameworks": { "$ref": "#/$defs/provenanced" },
            "framework_tool_calling_notes": { "type": ["string", "null"] }
          }
        },
        "notes": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
