{
  "name": "mcp-token-footprint",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm docs:bundle && pnpm -r --sort build",
    "docs:bundle": "node scripts/build-docs-bundle.mjs",
    "build:model-data": "pnpm --filter @mcp-token-footprint/api exec tsx src/compatibility/build-cli.ts",
    "mcp:self-scan": "pnpm --filter @mcp-token-footprint/shared build && pnpm --filter @mcp-token-footprint/api exec tsx src/mcp-server/self-scan-cli.ts",
    "dev": "pnpm docs:bundle && pnpm --filter @mcp-token-footprint/shared build && pnpm --parallel --filter @mcp-token-footprint/api --filter @mcp-token-footprint/web dev",
    "dev:api": "pnpm --filter @mcp-token-footprint/shared build && pnpm --filter @mcp-token-footprint/api dev",
    "dev:web": "pnpm docs:bundle && pnpm --filter @mcp-token-footprint/shared build && pnpm --filter @mcp-token-footprint/web dev",
    "start": "node apps/api/dist/index.js",
    "typecheck": "pnpm -r --sort typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "biome check --formatter-enabled=false .",
    "mcpfp": "pnpm --filter @mcp-token-footprint/cli run mcpfp --",
    "okf": "python3 planning/.claude/scripts/okf.py --root planning",
    "okf:validate": "python3 planning/.claude/scripts/okf.py --root planning validate",
    "okf:sync": "python3 planning/.claude/scripts/okf.py --root planning sync-indexes",
    "okf:test": "python3 -m unittest discover -s planning/.claude/tests -p 'test_*.py'",
    "format": "biome format --write .",
    "test:e2e": "pnpm build && playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@elabs-ai/components-cli": "^4.0.0",
    "@playwright/test": "1.56.0",
    "@types/node": "^22.20.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "node-pty@1.1.0": "patches/node-pty@1.1.0.patch"
    }
  }
}
